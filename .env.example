# ==========================================
# BookLeaf Author Support Portal - Environment
# ==========================================

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Database connection URL
# Local PostgreSQL default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf_db
# Supabase PostgreSQL example:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# JWT Security
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# AI Configuration (Google Gemini)
# Obtain an API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_SECONDS=20

# ====================================================
# Secured Credentials & Accounts Bootstrap
# (Keep this file confidential; never expose in UI)
# ====================================================
ENABLE_DEMO_BOOTSTRAP=True

# Administrator Account
ADMIN_EMAIL=admin@bookleaf.com
ADMIN_PASSWORD=AdminSecure@2026

# Default Author Password fallback
DEMO_AUTHOR_PASSWORD=AuthorDemo@2026

